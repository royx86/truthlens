# ── Apify ─────────────────────────────────────────────────────────────────────
# Your Apify API token.
# Obtain from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# The Apify Actor ID to use for Instagram scraping.
# Find the Actor ID in the Apify Console URL:
#   https://console.apify.com/actors/<actor-id>
# Example actors (verify input schema before use):
#   apify/instagram-scraper
#   zuzka/instagram-scraper
# Set to the exact Actor ID shown in the Apify Console.
APIFY_INSTAGRAM_ACTOR=your_instagram_actor_id_here

# The Apify Actor ID to use for Facebook scraping.
# Official Apify-maintained Facebook Posts Scraper:
#   apify/facebook-posts-scraper
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL database URL with asyncpg driver.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/truthlens

# ── JWT / Security ───────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Public frontend URL in production. Set this to your Railway frontend domain.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins for CORS.
# Default: http://localhost:5173, http://localhost:5174
# CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174"]
